# 1. Supabase (PostgreSQL + PostGIS) - Free at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. NASA FIRMS MAP_KEY - Free instant key at https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# 3. Telegram Alert Bot (Optional for Live Phone Demo) - Free via @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
